# Copy to .ci-local.env (gitignored) and fill in. Read as data, never committed, never sourced by a shell: by
# scripts/check-repo.mjs and scripts/release.sh (the emails), scripts/dev/export-public.sh (both) and
# scripts/test/repo-docs.test.mjs (the phrases). An environment variable of the same name takes precedence.
# In a git worktree the main worktree's .ci-local.env is used when the worktree has none.
#
# Addresses that must never appear in a tracked file, comma or space separated, compared case-insensitively.
# (The value below is a synthetic placeholder; put the real address in your own .ci-local.env only.)
WASITME_FORBIDDEN_EMAILS=someone@example.invalid
#
# Phrases from private notes that must never reach the public tree, comma separated (a phrase may contain spaces), at
# least 5 characters each, compared case-insensitively. Keep them here, never in a tracked file, so the check does not
# publish what it guards. (The values below are synthetic placeholders.)
WASITME_FORBIDDEN_PHRASES=synthetic private phrase, another-synthetic-phrase
